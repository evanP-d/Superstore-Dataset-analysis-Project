    <worksheet name='Time Period'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Sample - Superstore)' name='federated.1qdwff21gnpzdh16wi39i1dibftr' />
            <datasource caption='参数' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Period Parameter' datatype='string' name='[参数 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Quarter&quot;'>
              <calculation class='tableau' formula='&quot;Quarter&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qdwff21gnpzdh16wi39i1dibftr'>
            <column caption='Display Time Period' datatype='string' name='[Calculation_0324087900356622]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Order Date] &gt;= DATEADD(&apos;day&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Day&quot;&#13;&#10;ELSEIF [Order Date] &gt;= DATEADD(&apos;month&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Month&quot;&#13;&#10;ELSEIF [Order Date] &gt;= DATEADD(&apos;quarter&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Quarter&quot;&#13;&#10;END' />
            </column>
            <column caption='Time Period - Select?' datatype='boolean' name='[Calculation_1524480296038401]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Display Time Period (复制)_0324087904485391] = [Parameters].[参数 1]' />
            </column>
            <column caption='Time Period' datatype='string' name='[Display Time Period (复制)_0324087904485391]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Order Date] &gt;= DATEADD(&apos;day&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Day,Month,Quarter&quot;&#13;&#10;ELSEIF [Order Date] &gt;= DATEADD(&apos;month&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Month,Quarter&quot;&#13;&#10;ELSEIF [Order Date] &gt;= DATEADD(&apos;quarter&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Quarter&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_0324087900356622]' derivation='None' name='[none:Calculation_0324087900356622:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1524480296038401]' derivation='None' name='[none:Calculation_1524480296038401:nk]' pivot='key' type='nominal' />
            <column-instance column='[Display Time Period (复制)_0324087904485391]' derivation='None' name='[none:Display Time Period (复制)_0324087904485391:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1qdwff21gnpzdh16wi39i1dibftr].[none:Display Time Period (复制)_0324087904485391:nk]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Display Time Period (复制)_0324087904485391:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:Display Time Period (复制)_0324087904485391:nk]' member='%null%' />
                <groupfilter function='member' level='[none:Display Time Period (复制)_0324087904485391:nk]' member='&quot;Day,Month,Quarter&quot;' />
              </groupfilter>
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.1qdwff21gnpzdh16wi39i1dibftr].[none:Display Time Period (复制)_0324087904485391:nk]</column>
          </slices>
