    <worksheet name='Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Sample - Superstore)' name='federated.1qdwff21gnpzdh16wi39i1dibftr' />
            <datasource caption='参数' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Period Parameter' datatype='string' name='[参数 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Quarter&quot;'>
              <calculation class='tableau' formula='&quot;Quarter&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qdwff21gnpzdh16wi39i1dibftr'>
            <column caption='Display Range - axis' datatype='string' name='[Calculation_1524480324059150]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([Parameters].[参数 1],&quot;Day&quot;) then str(datepart(&quot;hour&quot;,[Order Date])) + &quot;:&quot; + right(&quot;00&quot; + str(Datepart(&quot;minute&quot;,[Order Date])),2)&#13;&#10;elseif contains([Parameters].[参数 1],&quot;Month&quot;) then str(day([Order Date]))&#13;&#10;elseif contains([Parameters].[参数 1],&quot;Quarter&quot;) then left(datename(&quot;month&quot;,[Order Date]),3) END' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_1524480330018832]' role='measure' type='quantitative' user:unnamed='Trend'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Time Period' datatype='string' name='[Display Time Period (复制)_0324087904485391]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Order Date] &gt;= DATEADD(&apos;day&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Day,Month,Quarter&quot;&#13;&#10;ELSEIF [Order Date] &gt;= DATEADD(&apos;month&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Month,Quarter&quot;&#13;&#10;ELSEIF [Order Date] &gt;= DATEADD(&apos;quarter&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Quarter&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1524480324059150]' derivation='None' name='[none:Calculation_1524480324059150:nk]' pivot='key' type='nominal' />
