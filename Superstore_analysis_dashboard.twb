    <worksheet name='Period Range'>
      <table>
        <view>
          <datasources>
            <datasource caption='Sheet1 (Sample - Superstore)' name='federated.1qdwff21gnpzdh16wi39i1dibftr' />
            <datasource caption='参数' name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Time Period Parameter' datatype='string' name='[参数 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Quarter&quot;'>
              <calculation class='tableau' formula='&quot;Quarter&quot;' />
            </column>
            <column caption='Period Range Parameter' datatype='string' name='[参数 2]' param-domain-type='any' role='measure' type='nominal' value='&quot;2017-12-23&quot;'>
              <calculation class='tableau' formula='&quot;2017-12-23&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1qdwff21gnpzdh16wi39i1dibftr'>
            <column caption='Period Range' datatype='string' name='[Calculation_1524480299601922]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([Parameters].[参数 1], &quot;Day&quot;) &#13;&#10;   AND [Order Date] &gt;= DATEADD(&apos;day&apos;, -15, #2017-12-30#) &#13;&#10;   AND DATE([Order Date]) &lt;= #2017-12-30#&#13;&#10;THEN STR(DATE([Order Date]))&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Parameters].[参数 1], &quot;Month&quot;) &#13;&#10;       AND [Order Date] &gt;= DATEADD(&apos;month&apos;, -15, #2017-12-30#) &#13;&#10;       AND DATE([Order Date]) &lt;= #2017-12-30#&#13;&#10;THEN STR(YEAR([Order Date])) + &quot;_&quot; + STR(MONTH([Order Date]))&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Parameters].[参数 1], &quot;Quarter&quot;) &#13;&#10;       AND [Order Date] &gt;= DATEADD(&apos;quarter&apos;, -15, #2017-12-30#) &#13;&#10;       AND DATE([Order Date]) &lt;= #2017-12-30#&#13;&#10;THEN STR(YEAR([Order Date])) + &quot;Q&quot; + STR(QUARTER([Order Date]))&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Display Range - 1st  Line' datatype='string' name='[Calculation_1524480302235651]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([Parameters].[参数 1],&quot;Day&quot;) THEN LEFT(DATENAME(&quot;weekday&quot;,[Order Date]),3)&#13;&#10;ELSEIF CONTAINS([Parameters].[参数 1],&quot;Month&quot;) THEN LEFT(DATENAME(&quot;month&quot;,[Order Date]),3)&#13;&#10;ELSEIF CONTAINS([Parameters].[参数 1],&quot;Quarter&quot;) THEN &quot;Q&quot; + STR(QUARTER([Order Date])) END' />
            </column>
            <column caption='Display Range - 2nd Line' datatype='string' name='[Calculation_1524480303030276]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([Parameters].[参数 1],&quot;Day&quot;) THEN STR(DAY([Order Date]))&#13;&#10;ELSEIF CONTAINS([Parameters].[参数 1],&quot;Month&quot;) THEN &quot;&apos;&quot; + RIGHT(STR(YEAR([Order Date])),2)&#13;&#10;ELSEIF CONTAINS([Parameters].[参数 1],&quot;Quarter&quot;) THEN &quot;&apos;&quot; + right(str(year([Order Date])),2) END' />
            </column>
            <column caption='Period Range - Select?' datatype='boolean' name='[Calculation_1524480304455685]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1524480299601922] = [Parameters].[参数 2]' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_1524480307425291]' role='measure' type='quantitative' user:unnamed='Period Range'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_1524480307449869]' role='measure' type='quantitative' user:unnamed='Period Range'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='Time Period' datatype='string' name='[Display Time Period (复制)_0324087904485391]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Order Date] &gt;= DATEADD(&apos;day&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Day,Month,Quarter&quot;&#13;&#10;ELSEIF [Order Date] &gt;= DATEADD(&apos;month&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Month,Quarter&quot;&#13;&#10;ELSEIF [Order Date] &gt;= DATEADD(&apos;quarter&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Quarter&quot;&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1524480299601922]' derivation='None' name='[none:Calculation_1524480299601922:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1524480302235651]' derivation='None' name='[none:Calculation_1524480302235651:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1524480303030276]' derivation='None' name='[none:Calculation_1524480303030276:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1524480304455685]' derivation='None' name='[none:Calculation_1524480304455685:nk]' pivot='key' type='nominal' />
            <column-instance column='[Display Time Period (复制)_0324087904485391]' derivation='None' name='[none:Display Time Period (复制)_0324087904485391:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1524480307425291]' derivation='Sum' name='[sum:Calculation_1524480307425291:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1524480307449869]' derivation='Sum' name='[sum:Calculation_1524480307449869:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1qdwff21gnpzdh16wi39i1dibftr].[none:Display Time Period (复制)_0324087904485391:nk]'>
