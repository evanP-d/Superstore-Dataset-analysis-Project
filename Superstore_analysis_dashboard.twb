      <column caption='Display Time Period' datatype='string' name='[Calculation_0324087900356622]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Order Date] &gt;= DATEADD(&apos;day&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Day&quot;&#13;&#10;ELSEIF [Order Date] &gt;= DATEADD(&apos;month&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Month&quot;&#13;&#10;ELSEIF [Order Date] &gt;= DATEADD(&apos;quarter&apos;, -15, #2017-12-30#) AND [Order Date] &lt;= #2017-12-30# THEN &quot;Quarter&quot;&#13;&#10;END' />
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_0602814412013568]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])/COUNTD([Order ID])' />
      </column>
      <column caption='L-M Orders' datatype='integer' name='[Calculation_0602814415835137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Is Loss])' />
      </column>
      <column caption='Total Customer' datatype='integer' name='[Calculation_0602814425735170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD( [Customer ID])' />
      </column>
      <column caption='Box2' datatype='string' name='[Calculation_0602814470082565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Box3' datatype='string' name='[Calculation_0602814494605318]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Time Period - Select?' datatype='boolean' name='[Calculation_1524480296038401]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Display Time Period (复制)_0324087904485391] = [Parameters].[参数 1]' />
      </column>
      <column caption='Period Range' datatype='string' name='[Calculation_1524480299601922]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Parameters].[参数 1], &quot;Day&quot;) &#13;&#10;   AND [Order Date] &gt;= DATEADD(&apos;day&apos;, -15, #2017-12-30#) &#13;&#10;   AND DATE([Order Date]) &lt;= #2017-12-30#&#13;&#10;THEN STR(DATE([Order Date]))&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Parameters].[参数 1], &quot;Month&quot;) &#13;&#10;       AND [Order Date] &gt;= DATEADD(&apos;month&apos;, -15, #2017-12-30#) &#13;&#10;       AND DATE([Order Date]) &lt;= #2017-12-30#&#13;&#10;THEN STR(YEAR([Order Date])) + &quot;_&quot; + STR(MONTH([Order Date]))&#13;&#10;&#13;&#10;ELSEIF CONTAINS([Parameters].[参数 1], &quot;Quarter&quot;) &#13;&#10;       AND [Order Date] &gt;= DATEADD(&apos;quarter&apos;, -15, #2017-12-30#) &#13;&#10;       AND DATE([Order Date]) &lt;= #2017-12-30#&#13;&#10;THEN STR(YEAR([Order Date])) + &quot;Q&quot; + STR(QUARTER([Order Date]))&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Display Range - 1st  Line' datatype='string' name='[Calculation_1524480302235651]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Parameters].[参数 1],&quot;Day&quot;) THEN LEFT(DATENAME(&quot;weekday&quot;,[Order Date]),3)&#13;&#10;ELSEIF CONTAINS([Parameters].[参数 1],&quot;Month&quot;) THEN LEFT(DATENAME(&quot;month&quot;,[Order Date]),3)&#13;&#10;ELSEIF CONTAINS([Parameters].[参数 1],&quot;Quarter&quot;) THEN &quot;Q&quot; + STR(QUARTER([Order Date])) END' />
      </column>
      <column caption='Display Range - 2nd Line' datatype='string' name='[Calculation_1524480303030276]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Parameters].[参数 1],&quot;Day&quot;) THEN STR(DAY([Order Date]))&#13;&#10;ELSEIF CONTAINS([Parameters].[参数 1],&quot;Month&quot;) THEN &quot;&apos;&quot; + RIGHT(STR(YEAR([Order Date])),2)&#13;&#10;ELSEIF CONTAINS([Parameters].[参数 1],&quot;Quarter&quot;) THEN &quot;&apos;&quot; + right(str(year([Order Date])),2) END' />
      </column>
      <column caption='Period Range - Select?' datatype='boolean' name='[Calculation_1524480304455685]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1524480299601922] = [Parameters].[参数 2]' />
      </column>
      <column caption='Display Range - axis' datatype='string' name='[Calculation_1524480324059150]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Parameters].[参数 1],&quot;Day&quot;) then str(datepart(&quot;hour&quot;,[Order Date])) + &quot;:&quot; + right(&quot;00&quot; + str(Datepart(&quot;minute&quot;,[Order Date])),2)&#13;&#10;elseif contains([Parameters].[参数 1],&quot;Month&quot;) then str(day([Order Date]))&#13;&#10;elseif contains([Parameters].[参数 1],&quot;Quarter&quot;) then left(datename(&quot;month&quot;,[Order Date]),3) END' />
      </column>
      <column caption='Location %' datatype='real' name='[Calculation_1524480345161762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [State]: SUM([Sales])} / {FIXED : SUM([Sales])}' />
